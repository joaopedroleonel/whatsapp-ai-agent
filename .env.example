# Copie para .env e preencha todos os valores (o app não inicia se faltar algum)

WHATSAPP_URL=https://web.whatsapp.com
# Pasta do perfil do Chrome, relativa à raiz do projeto (mantém o login do QR code)
CHROME_PROFILE_DIR=app/chrome-profile

# Segundos
LOGIN_TIMEOUT=300
CHECK_INTERVAL=10
OPEN_TIMEOUT=10

# Navegação pelo teclado
MAX_TABS=60
MAX_ARROWS=50
KEY_DELAY_MIN=0.25
KEY_DELAY_MAX=0.6

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TEMPERATURE=0.2
# Máximo de tokens: instruções + histórico + resposta (pequeno demais corta as instruções)
OLLAMA_NUM_CTX=8192
# Batch maior = leitura do prompt bem mais rápida na GPU
OLLAMA_NUM_BATCH=2048
# Tamanho máximo da resposta em tokens
OLLAMA_NUM_PREDICT=256
# Quanto tempo o modelo fica carregado após a última chamada (ex.: 30m, 1h, -1 = sempre)
OLLAMA_KEEP_ALIVE=1h
