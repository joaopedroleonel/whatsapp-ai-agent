# Copy to .env and fill every value (the app refuses to start if one is missing)

WHATSAPP_URL=https://web.whatsapp.com
# Chrome profile folder, relative to the project root (keeps the QR code login)
CHROME_PROFILE_DIR=app/chrome-profile

# Seconds
LOGIN_TIMEOUT=300
CHECK_INTERVAL=10
OPEN_TIMEOUT=10

# Keyboard navigation
MAX_TABS=60
MAX_ARROWS=50
KEY_DELAY_MIN=0.25
KEY_DELAY_MAX=0.6

# Ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma4:e2b
OLLAMA_TEMPERATURE=0.2
# Max tokens: system prompt + history + reply (too small cuts the instructions)
OLLAMA_NUM_CTX=8192
# Bigger batch = much faster prompt processing on GPU
OLLAMA_NUM_BATCH=2048
# Max reply length in tokens
OLLAMA_NUM_PREDICT=256
# How long the model stays loaded after the last call (e.g. 30m, 1h, -1 = forever)
OLLAMA_KEEP_ALIVE=1h
