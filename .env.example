# Copie para .env. Só os valores do bloco "Obrigatório" precisam ser preenchidos

# ===== Obrigatório =====
# Qualquer API compatível com OpenAI (Chat Completions)
AI_BASE_URL=https://openrouter.ai/api/v1
AI_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free

# ===== Opcional (valor padrão ao lado) =====
# Chave da API do provedor
AI_API_KEY=
# Parâmetros extras do provedor, em JSON. Ex. OpenRouter sem raciocínio: {"reasoning": {"enabled": false}}
AI_EXTRA_BODY=
AI_TEMPERATURE=0.2
# Tamanho máximo da resposta em tokens
AI_MAX_TOKENS=256
# Tempo máximo de espera pela IA, em segundos
AI_TIMEOUT=60
# Enviar as mensagens anteriores da conversa para a IA (true/false)
AI_HISTORY=true

# Nome em negrito antes de cada resposta (*[Nome]*). Vazio = sem nome
SENDER_NAME=

WHATSAPP_URL=https://web.whatsapp.com
# Pasta do perfil do navegador, relativa à raiz do projeto (mantém o login do QR code)
BROWSER_PROFILE_DIR=app/browser-profile
# Caminho do executável de um navegador Chromium (Edge, Brave...). Vazio = procura o Chrome sozinho
# Ex.: C:\Program Files (x86)\Microsoft\Edge\Application\msedge.exe
BROWSER_PATH=

# Tempos, em segundos
LOGIN_TIMEOUT=300
CHECK_INTERVAL=5
OPEN_TIMEOUT=5
# Espera após enviar a mensagem, antes de fechar a conversa com Esc
SEND_WAIT=2

# Navegação pelo teclado
MAX_TABS=60
MAX_ARROWS=50
KEY_DELAY_MIN=0.25
KEY_DELAY_MAX=0.6
# Pausa entre cada caractere digitado
TYPING_DELAY_MIN=0.03
TYPING_DELAY_MAX=0.1